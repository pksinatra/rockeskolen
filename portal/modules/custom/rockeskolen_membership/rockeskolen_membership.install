<?php

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function rockeskolen_membership_schema(): array {
  $schema['rockeskolen_vip_grant'] = [
    'description' => 'External sources that grant Drupal VIP membership.',
    'fields' => [
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'source' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'source_id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'active' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['source', 'source_id'],
    'indexes' => ['uid_active' => ['uid', 'active']],
  ];
  $schema['rockeskolen_vip_managed'] = [
    'description' => 'Tracks VIP roles added by automated grants.',
    'fields' => [
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['uid'],
  ];
  return $schema;
}

/**
 * Creates source-aware VIP grant storage.
 */
function rockeskolen_membership_update_11001(): string {
  $schema = \Drupal::database()->schema();
  foreach (rockeskolen_membership_schema() as $table => $definition) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definition);
    }
  }
  return 'Created Rockeskolen VIP grant storage.';
}

/**
 * Adds the editorial access-tier field to all node bundles.
 */
function rockeskolen_membership_update_11002(): string {
  rockeskolen_membership_install_access_field();
  return 'Added the Rockeskolen article access tier field.';
}

/**
 * Ensures the access-tier field is visible in all node edit forms.
 */
function rockeskolen_membership_update_11003(): string {
  rockeskolen_membership_install_access_field();
  return 'Placed the Rockeskolen access tier field in node edit forms.';
}

/**
 * Implements hook_install().
 */
function rockeskolen_membership_install(): void {
  rockeskolen_membership_install_access_field();
}

/**
 * Creates the access-tier field without changing existing editorial content.
 */
function rockeskolen_membership_install_access_field(): void {
  $field_storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_access_level');
  if (!$field_storage) {
    $field_storage = \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_access_level',
      'entity_type' => 'node',
      'type' => 'list_string',
      'cardinality' => 1,
      'settings' => [
        'allowed_values' => [
          'public' => 'Åpen',
          'authenticated' => 'Innlogget',
          'vip' => 'VIP',
        ],
      ],
    ]);
    $field_storage->save();
  }

  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo('node');
  foreach (array_keys($bundle_info) as $bundle) {
    if (\Drupal\field\Entity\FieldConfig::loadByName('node', $bundle, 'field_access_level')) {
      continue;
    }
    \Drupal\field\Entity\FieldConfig::create([
      'field_name' => 'field_access_level',
      'entity_type' => 'node',
      'bundle' => $bundle,
      'label' => 'Tilgangsnivå',
      'description' => 'Velg hvem som kan lese hovedinnholdet. Standard er Åpen.',
      'required' => TRUE,
      'default_value' => [['value' => 'public']],
    ])->save();
    $form_display_storage = \Drupal::entityTypeManager()->getStorage('entity_form_display');
    $form_display = $form_display_storage->load('node.' . $bundle . '.default');
    if ($form_display) {
      $form_display->setComponent('field_access_level', [
        'type' => 'options_select',
        'weight' => -20,
      ])->save();
    }
  }
}

